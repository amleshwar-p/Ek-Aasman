# Copy this file to .env.local for local development.
# Without the Upstash values the app runs on an in-memory store (fine for trying it out locally;
# everything resets when the dev server restarts).

# Upstash Redis. When you add Upstash from the Vercel dashboard (Storage -> Marketplace -> Upstash for Redis)
# these are filled in for you automatically. Either naming works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Any long random string. Signs the little "who you are" token kept in each visitor's browser.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
